<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Demon Slayer API</title>
    <link href="https://fonts.googleapis.com/css2?family=Courier+Prime:wght@400;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://kit.fontawesome.com/36aa95581e.js" crossorigin="anonymous"></script>
    <script>
        (() => {
            let savedTheme = null;

            try {
                savedTheme = localStorage.getItem('theme');
            } catch (error) {
                savedTheme = null;
            }

            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

            if (savedTheme || prefersDark) {
                document.documentElement.dataset.theme = savedTheme || 'dark';
            }
        })();
    </script>
    <link rel="stylesheet" type="text/css" href="/css/style.css">
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
        <nav class="nav-shell" aria-label="Primary navigation">
            <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false" title="Toggle dark mode">
                <span class="theme-toggle-icon" aria-hidden="true"></span>
            </button>
            <a class="github-link" href="https://github.com/gwendolyn954/demon-slayer-api" aria-label="View GitHub repository" title="View GitHub repository" rel="noreferrer">
                <img src="/assets/github-white-icon.png" alt="" aria-hidden="true">
            </a>
        </nav>
    </header>

    <main id="main-content">
        <section class="masthead" aria-labelledby="page-title">
            <div class="container masthead-shell">
                <p class="masthead-kicker">REST API • No Auth Required</p>
                <h1 id="page-title">Demon Slayer API</h1>
            </div>
        </section>

        <section class="intro-section">
            <div class="container intro-grid">
                <div class="intro-copy">
                    <p class="eyebrow">Designed for developers and fans</p>
                    <h2>Demon Slayer API</h2>
                    <p class="intro-text">The Demon Slayer API provides access to a collection of character facts from the popular anime and manga series, Demon Slayer: Kimetsu no Yaiba.</p>
                    <div class="endpoint-pills" aria-label="Available endpoint examples">
                        <code>GET /api</code>
                        <code>GET /api/:name</code>
                        <code>GET /api/race/human</code>
                        <code>GET /api/race/demon</code>
                    </div>
                </div>

                <figure class="featured-image">
                    <img src="/assets/tanjiro-nezuko.png" alt="Tanjiro carrying Nezuko in her basket.">
                </figure>
            </div>
        </section>

        <section class="try-section">
            <div class="container">
                <section class="try-panel" aria-labelledby="demo-title">
                    <div class="section-heading">
                        <p class="eyebrow">Try it</p>
                        <h2 id="demo-title">Search the API</h2>
                    </div>

                    <label class="search-label" for="character-search">Enter a character name...</label>
                    <div class="search-row">
                        <input id="character-search" type="text" placeholder="tanjiro, nezuko, rengoku" name="characterName" value="" autocomplete="off">
                        <button id="search-btn" class="primary-btn" type="button">
                            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                            <span>Search</span>
                        </button>
                        <button id="reset-btn" class="icon-btn" type="button" aria-label="Clear results" title="Clear results">
                            <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
                            <span>Reset</span>
                        </button>
                    </div>

                    <div class="result" aria-live="polite">
                        <ul id="character-list"></ul>
                    </div>
                </section>
            </div>
        </section>

        <section id="documentation" class="docs-section">
            <div class="container">
                <div class="section-heading">
                    <p class="eyebrow">Documentation</p>
                    <h2>Endpoints</h2>
                    <p>All responses include the original character facts plus <code>essenceCard</code> and <code>essenceCardAlt</code> fields for local PNG assets.</p>
                </div>

                <div class="endpoint-list" aria-label="API endpoints">
                    <article class="endpoint-card">
                        <div>
                            <span class="method">GET</span>
                            <code>/api</code>
                        </div>
                        <p>Returns facts for all characters.</p>
                    </article>

                    <article class="endpoint-card">
                        <div>
                            <span class="method">GET</span>
                            <code>/api/:name</code>
                        </div>
                        <p>Returns matching characters by name. Example: <code>/api/tanjiro</code></p>
                    </article>

                    <article class="endpoint-card">
                        <div>
                            <span class="method">GET</span>
                            <code>/api/race/human</code>
                        </div>
                        <p>Returns all human characters.</p>
                    </article>

                    <article class="endpoint-card">
                        <div>
                            <span class="method">GET</span>
                            <code>/api/race/demon</code>
                        </div>
                        <p>Returns all demon characters.</p>
                    </article>
                </div>
            </div>
        </section>
    </main>

    <footer>
        <div class="container footer-shell">
            <p>Demon Slayer Character API</p>
            <a class="github-link" href="https://github.com/gwendolyn954/demon-slayer-api" aria-label="View GitHub repository" title="View GitHub repository" rel="noreferrer">
                <img src="/assets/github-icon.png" alt="" aria-hidden="true">
            </a>
        </div>
    </footer>

    <script src="/js/main.js"></script>
</body>
</html>
